-- Formatting (Changing the format of the value from one to another)
-- Casting (Changing the data type from one to another)

SELECT 
	creationtime,
	TO_CHAR (creationtime, 'MM-dd-yyyy') AS US_format,
	TO_CHAR (creationtime, 'dd-MM-yyyy') AS EURO_format,
	TO_CHAR (creationtime, 'dd') AS dd,
	TO_CHAR (creationtime, 'dy') AS shortform,
	TO_CHAR (creationtime, 'day') AS longform,
	TO_CHAR (creationtime, 'mm') AS mm,
	TO_CHAR (creationtime, 'mon') AS shortform,
	TO_CHAR (creationtime, 'month') AS shortform
FROM orders;

--Show creation time using the following format - Day Wed Jan Q1 2025 12:34:56 PM
SELECT 
	orderid,
	creationtime,
	'Day ' || TO_CHAR(creationtime, 'Dy Mon') 
	|| ' Q' || TO_CHAR(creationtime, 'Q YYYY hh:mm:ss AM') AS CustomFormat
FROM orders;

-- Extract the sales by month from the orders table
SELECT 
	TO_CHAR(orderdate, 'Mon yy') as orderdate,
	COUNT(*)
FROM orders
GROUP BY TO_CHAR(orderdate, 'Mon yy')

-- CAST(Converts a date and time value to a different data type and formats the value)
SELECT 
	CAST('123' AS INT) AS String_to_int,
	CAST('2020-12-11' AS DATE) AS String_to_date,
	creationtime,
	CAST(creationtime AS DATE) AS datetime_to_date
FROM orders;

--Column_name +/- INTERVAL 'no of day/month/year' ( Adds or subtracts a specific time interval to/from a date)

SELECT
	orderid,
	orderdate,
	orderdate + INTERVAL '2 years' AS twoyrslater,
	orderdate - INTERVAL '2 years' AS twoyrsprior
FROM orders;
