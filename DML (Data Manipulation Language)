--Copy data from 'customers' table into 'persons'
CREATE TABLE persons(
	id INT NOT NULL PRIMARY KEY,
	person_name VARCHAR(50) NOT NULL,
	birth_date DATE,
	phone VARCHAR(15) NOT NULL
);

INSERT INTO persons (id, person_name, birth_date, phone)
SELECT
	id, 
	first_name,
	NULL as birth_date,
	'Unknown' as phone
FROM customers;

